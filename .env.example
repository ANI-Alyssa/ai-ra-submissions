# Postgres connection string (Vercel Postgres, Neon, Supabase, etc.). Get this from your Vercel
# project's Storage tab after adding a Postgres database, or from your provider's dashboard.
DATABASE_URL=""

# Public base URL this app is reachable at — used to turn uploaded attachment paths into links
# Mae/Alyssa can open from inside ClickUp. Leave blank while only running on localhost.
APP_BASE_URL=""

# Vercel Blob storage for attachments — auto-injected by Vercel once you add Blob storage to the
# project (Storage tab -> Create -> Blob), no manual setup needed in production. Leave blank
# locally: uploads fall back to local disk (see lib/upload.ts) so `npm run dev` needs no Blob
# credentials at all.
BLOB_READ_WRITE_TOKEN=""

# AI provider — "anthropic" is the only implementation for now; architecture supports adding
# "openai" / "gemini" later behind the same AIProvider interface (lib/ai/types.ts)
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-5"

# Minimum overall quality score (0-100) required for AI auto-approval
AI_APPROVAL_THRESHOLD="70"

# ClickUp integration — leave CLICKUP_API_TOKEN blank to run in dry-run mode
# (submissions are marked "approved, ClickUp pending" instead of erroring)
# Workspace: Alyssa Nobriga (8507933) -> ANI EA space -> "R&A Guide Submissions (EA)" folder
# -> "Mae Submissions" list (id 901703878273). Get a personal API token from
# ClickUp -> Settings -> Apps -> API Token.
CLICKUP_API_TOKEN=""
CLICKUP_LIST_ID="901703878273"
CLICKUP_MAE_ASSIGNEE_ID="107615809"

# Field name -> ClickUp custom field ID mapping (JSON), resolved from the real "Mae Submissions"
# list's field definitions. Only text/number/date fields are mapped here — "Submitted By" is a
# users field (needs a ClickUp user ID, submitters may not have an account) so it's left
# description-only. "ANI Department" is handled separately below since it's a drop_down.
CLICKUP_CUSTOM_FIELD_MAP='{"Context":"b4059c8f-dcab-49b8-aacd-f27b5377d58a","Decision Needed":"264cc478-a179-4d84-baf4-45742fa32c43","Assets to Review":"346ccc19-c3dc-490e-873d-200c81de968c"}'

# "ANI Department" drop_down field: field ID + our department enum -> ClickUp option UUID
CLICKUP_DEPARTMENT_FIELD_ID="387df6f6-4ea0-495f-a027-d21e571c87dc"
CLICKUP_DEPARTMENT_OPTIONS='{"MARKETING":"5c8b69d4-4ecd-434e-84cf-a303da3b2c59","PODCAST":"1b4105bb-8110-4650-9b35-6d27a67e4d53","OPERATIONS":"e574fc22-d22d-4bae-9678-ea01c6c35678","TECH":"7273763f-63d6-4e91-84af-1ecf246470f5","PROGRAM":"2f85aec5-7cba-4d62-bfb8-42670e855515","CONTENT":"4d4d4f0f-489c-4387-abbc-6661be1d8aed","EA_SUPPORT":"232f3e08-7206-4f42-9de9-75e30770e344"}'

# Google Sheets sync ("Tasks + Approvals" tracker) — leave GOOGLE_SHEETS_WEBHOOK_URL blank to
# skip (no-op, non-fatal). Set up per google-apps-script/Code.gs: paste that script into the
# sheet's Extensions -> Apps Script, deploy as a Web App, paste the /exec URL below. The secret
# must match the SHARED_SECRET constant in that script.
GOOGLE_SHEETS_WEBHOOK_URL=""
GOOGLE_SHEETS_SHARED_SECRET=""
