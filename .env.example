# Database (SQLite for local dev; swap to Postgres connection string in production)
DATABASE_URL="file:./dev.db"

# Public base URL this app is reachable at — used to turn uploaded attachment paths into links
# Mae/Alyssa can open from inside ClickUp. Leave blank while only running on localhost.
APP_BASE_URL=""

# AI provider — "anthropic" is the only implementation for now; architecture supports adding
# "openai" / "gemini" later behind the same AIProvider interface (lib/ai/types.ts)
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-5"

# Minimum overall quality score (0-100) required for AI auto-approval
AI_APPROVAL_THRESHOLD="80"

# ClickUp integration — leave CLICKUP_API_TOKEN blank to run in dry-run mode
# (submissions are marked "approved, ClickUp pending" instead of erroring)
# Workspace: Alyssa Nobriga (8507933) -> ANI EA space -> "R&A Guide Submissions (EA)" folder
# -> "Mae Submissions" list (id 901703878273). Get a personal API token from
# ClickUp -> Settings -> Apps -> API Token.
CLICKUP_API_TOKEN=""
CLICKUP_LIST_ID="901703878273"
CLICKUP_MAE_ASSIGNEE_ID="107615809"

# Field name -> ClickUp custom field ID mapping (JSON), resolved from the real "Mae Submissions"
# list's field definitions. Only text/number/date fields are mapped here — "ANI Department" and
# "Department" are drop_downs and "Submitted By" is a users field, both need ID lookups this app
# doesn't do yet, so they're covered via the task description instead.
CLICKUP_CUSTOM_FIELD_MAP='{"Decision Needed":"264cc478-a179-4d84-baf4-45742fa32c43","Assets to Review":"346ccc19-c3dc-490e-873d-200c81de968c","Publish Date":"a07e5572-eb30-4a8b-9931-c86a59ea4568"}'
